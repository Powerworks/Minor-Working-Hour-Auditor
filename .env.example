# ClickHouse Database Connection Configuration
# Copy this file to .env and set your credentials.

# Local Docker setup (default):
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false

# ClickHouse Cloud configuration example:
# CLICKHOUSE_HOST=your-instance.region.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your_secure_password
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_SECURE=true

# Google Gemini API Configuration (for Gemini 2.5 Flash compliance reasoning)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

